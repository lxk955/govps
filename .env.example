# ==============================================================================
# GoVPS 生产环境配置示例（VPS 部署）
# 复制为 .env 并填写后即可启动：cp .env.example .env
# ==============================================================================

# 站点域名（Caddy 自动申请 SSL 证书与域名路由，例如：govps.xyz 或 vps.govps.xyz）
# 本地测试可设为 localhost
SITE_DOMAIN=govps.xyz

# 外部访问完整 URL（无末尾斜杠）
SITE_URL=https://govps.xyz

# 定时任务安全 Token（调用 /api/tasks/scan、/api/tasks/update-rates、/api/tasks/backup-db 时需在 Header 携带 X-Task-Token）
TASK_TOKEN=your-random-secret-token-here

# Resend 邮件发送 API Key（用户登录验证码发信使用；若为空则自动输出调试验证码）
RESEND_API_KEY=

# 验证码邮件发信人
MAIL_FROM=GoVPS · VPS雷达 <notify@govps.xyz>

# 商家抓取全局间隔（分钟，默认 5 分钟）
CRAWL_INTERVAL_MINUTES=5

# Cloudflare R2 数据库备份（私有桶；密钥只放本文件，勿提交 git）
# 开通：https://dash.cloudflare.com/?to=/:account/r2/overview
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=govps-backups
# 一般不用填，默认 https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# 外部暴露 HTTP / HTTPS 端口
HTTP_PORT=80
HTTPS_PORT=443
