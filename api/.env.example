# 数据库：本地开发用 SQLite，线上填 Neon 的连接串
DATABASE_URL=sqlite:///./vps_scout.db
# DATABASE_URL=postgresql+psycopg://user:pass@xxx.neon.tech/vpsscout?sslmode=require

# 定时任务接口的访问令牌（cron-job.org 请求时带上，防止被任意触发）
TASK_TOKEN=change-me-to-a-random-string

# Resend 邮件服务
RESEND_API_KEY=
MAIL_FROM=VPS 雷达 <notify@govps.xyz>

# 后端公网地址（用于生成邮件中的 /go 跳转链接）
PUBLIC_API_URL=http://localhost:8000

# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173

# 同产品同事件的去重窗口（分钟）
EVENT_DEDUP_MINUTES=30

# 每用户每日邮件上限
DAILY_MAIL_CAP=10

# ── P7 分级调度 / 邮件异步 worker（均有代码默认值，按需覆盖）──
# 全局兜底抓取间隔（分钟）；商家表 crawl_interval_minutes 列优先，其次各 adapter 默认值
CRAWL_INTERVAL_MINUTES=5
# 进程内邮件发送线程：false 时改由 POST /api/tasks/process-emails 驱动
NOTIFY_WORKER_ENABLED=true
NOTIFY_WORKER_INTERVAL_SECONDS=10
# 单封邮件最大尝试次数，耗尽后 NotifyLog 置 failed（终态可观察）
EMAIL_MAX_ATTEMPTS=3
